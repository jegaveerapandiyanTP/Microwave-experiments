clc;
clear;
close all;

%% ============================================================
% EXPERIMENT 1: TE10 MODE SIMULATION
% WR-90 RECTANGULAR WAVEGUIDE
% ============================================================

%% INPUT PARAMETERS

a = 22.86e-3;          % Waveguide width (m)
b = 10.16e-3;          % Waveguide height (m)
L = 100e-3;            % Waveguide length (m)

f = 10e9;              % Operating frequency (Hz)

c = 3e8;               % Speed of light (m/s)

% Enter the cutoff frequency obtained from HFSS
% Replace this value with your actual HFSS result

fc_sim = 6.56e9;       % HFSS simulated cutoff frequency (Hz)


%% ============================================================
% 1. THEORETICAL CUTOFF FREQUENCY
% ============================================================

% For dominant TE10 mode:
%
% fc = c/(2a)

fc_theory = c/(2*a);


%% ============================================================
% 2. PROPAGATION CONSTANT
% ============================================================

% beta = (2*pi*f/c)*sqrt(1-(fc/f)^2)

beta = (2*pi*f/c) * sqrt(1 - (fc_theory/f)^2);


%% ============================================================
% 3. PERCENTAGE DEVIATION
% ============================================================

percentage_deviation = ...
    abs(fc_sim - fc_theory)/fc_theory * 100;


%% ============================================================
% 4. WAVELENGTH AND PROPAGATION INFORMATION
% ============================================================

lambda0 = c/f;                 % Free-space wavelength
lambda_g = 2*pi/beta;         % Guide wavelength


%% ============================================================
% DISPLAY RESULTS
% ============================================================

fprintf('\n');
fprintf('====================================================\n');
fprintf('        WR-90 TE10 MODE SIMULATION\n');
fprintf('====================================================\n');

fprintf('\nINPUT PARAMETERS\n');
fprintf('Waveguide Width (a)  = %.2f mm\n',a*1000);
fprintf('Waveguide Height (b) = %.2f mm\n',b*1000);
fprintf('Waveguide Length (L) = %.2f mm\n',L*1000);
fprintf('Operating Frequency  = %.2f GHz\n',f/1e9);

fprintf('\n----------------------------------------------------\n');
fprintf('CUTOFF FREQUENCY\n');
fprintf('----------------------------------------------------\n');

fprintf('Theoretical fc       = %.4f GHz\n',fc_theory/1e9);
fprintf('HFSS Simulated fc    = %.4f GHz\n',fc_sim/1e9);

fprintf('Percentage Deviation = %.4f %%\n',...
        percentage_deviation);

fprintf('\n----------------------------------------------------\n');
fprintf('PROPAGATION PARAMETERS\n');
fprintf('----------------------------------------------------\n');

fprintf('Propagation Constant beta = %.4f rad/m\n',beta);
fprintf('Free-space Wavelength     = %.4f mm\n',...
        lambda0*1000);
fprintf('Guide Wavelength          = %.4f mm\n',...
        lambda_g*1000);

fprintf('\n====================================================\n');


%% ============================================================
% 5. TE10 ELECTRIC FIELD DISTRIBUTION
% ============================================================

% Spatial grid inside the waveguide

Nx = 50;
Ny = 25;

x = linspace(0,a,Nx);
y = linspace(0,b,Ny);

[X,Y] = meshgrid(x,y);


% TE10 Electric Field
%
% Ey = E0*sin(pi*x/a)

Ey = sin(pi*X/a);

Ex = zeros(size(X));


%% ============================================================
% 6. TE10 MAGNETIC FIELD DISTRIBUTION
% ============================================================

% Simplified normalized transverse magnetic field

Hx = zeros(size(X));

Hy = cos(pi*X/a);


% Longitudinal magnetic field

Hz = cos(pi*X/a);


%% ============================================================
% 7. ELECTRIC FIELD VECTOR PLOT
% ============================================================

figure('Name','TE10 Electric Field');

quiver(X*1000,Y*1000,...
       Ex,Ey,...
       'LineWidth',1.3);

hold on;

rectangle('Position',...
    [0 0 a*1000 b*1000],...
    'EdgeColor','k',...
    'LineWidth',2);

xlabel('Waveguide Width x (mm)');
ylabel('Waveguide Height y (mm)');

title('TE_{10} Electric Field Distribution');

axis equal;
grid on;


%% ============================================================
% 8. MAGNETIC FIELD VECTOR PLOT
% ============================================================

figure('Name','TE10 Magnetic Field');

quiver(X*1000,Y*1000,...
       Hx,Hy,...
       'LineWidth',1.3);

hold on;

rectangle('Position',...
    [0 0 a*1000 b*1000],...
    'EdgeColor','k',...
    'LineWidth',2);

xlabel('Waveguide Width x (mm)');
ylabel('Waveguide Height y (mm)');

title('TE_{10} Magnetic Field Distribution');

axis equal;
grid on;


%% ============================================================
% 9. 3-D ELECTRIC FIELD DISTRIBUTION
% ============================================================

figure('Name','TE10 3D Electric Field');

surf(X*1000,Y*1000,Ey);

xlabel('x (mm)');
ylabel('y (mm)');
zlabel('Normalized E_y');

title('TE_{10} Electric Field Distribution');

shading interp;
colorbar;
grid on;
view(45,30);


%% ============================================================
% 10. 3-D MAGNETIC FIELD DISTRIBUTION
% ============================================================

figure('Name','TE10 3D Magnetic Field');

surf(X*1000,Y*1000,Hz);

xlabel('x (mm)');
ylabel('y (mm)');
zlabel('Normalized H_z');

title('TE_{10} Magnetic Field Distribution');

shading interp;
colorbar;
grid on;
view(45,30);


%% ============================================================
% 11. PROPAGATION ALONG 100 mm WAVEGUIDE
% ============================================================

z = linspace(0,L,200);

% Field variation along z

E_z = cos(beta*z);

figure('Name','TE10 Propagation');

plot(z*1000,E_z,'LineWidth',2);

xlabel('Waveguide Length z (mm)');
ylabel('Normalized Field');

title('TE_{10} Mode Propagation Along WR-90 Waveguide');

grid on;


%% ============================================================
% FINAL RESULT
% ============================================================

fprintf('\nRESULT:\n');

if f > fc_theory
    fprintf('TE10 mode is ABOVE CUT-OFF and propagates.\n');
else
    fprintf('TE10 mode is BELOW CUT-OFF.\n');
end

fprintf('Theoretical cutoff frequency = %.4f GHz\n',...
        fc_theory/1e9);

fprintf('Propagation constant beta = %.4f rad/m\n',...
        beta);

fprintf('Deviation from HFSS result = %.4f %%\n',...
        percentage_deviation);
